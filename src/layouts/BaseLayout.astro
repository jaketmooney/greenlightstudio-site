---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Homepage only: overlay the header on the hero instead of a solid bar. */
  transparentHeader?: boolean;
}
const { title, description, image, transparentHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og-default.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Recreates the old Duda site's favicon at full resolution; the source
        and how to re-render it are in scripts/favicon.html. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Motion: switch on before first paint so revealed content never flashes
        visible-then-hidden. Skipped for reduced-motion visitors. If the reveal
        script below hasn't run within 3s, motion is switched back off so
        nothing can stay hidden. */}
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('motion');
        setTimeout(function () {
          if (!document.documentElement.dataset.motionReady) document.documentElement.classList.remove('motion');
        }, 3000);
      }
    </script>
    {/* Cloudflare Web Analytics: free, cookieless, so no consent banner is
        needed. The token is issued when the Pages project exists (Task 10)
        and is supplied as a build-time env var, so no placeholder ships. */}
    {
      import.meta.env.PUBLIC_CF_BEACON && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON}"}`}
        />
      )
    }
  </head>
  <body class="font-body bg-gls-paper text-gls-ink">
    <SiteHeader transparent={transparentHeader} />
    <main><slot /></main>
    <SiteFooter />
    {/* Scroll reveals (styles in global.css). [data-reveal] elements fade up
        the first time they enter view; ones that arrive together are staggered.
        A [data-reveal-group] reveals all its [data-reveal] children at once
        while it is a sideways-scrolling row (off-screen cards would otherwise
        wait until swiped); laid out as a grid, its children reveal one by one. [data-count] numbers count up from zero. Inline, so
        it can't fail to load. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!root.classList.contains('motion')) return;
        var STEP = 90, MAX_STEPS = 6;

        function countUp(el) {
          var target = Number(el.dataset.count), start = performance.now(), dur = 1200;
          (function tick(now) {
            var t = Math.min(1, (now - start) / dur);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - t, 3))));
            if (t < 1) requestAnimationFrame(tick);
          })(start);
        }
        function reveal(el, i) {
          el.style.setProperty('--reveal-delay', Math.min(i, MAX_STEPS) * STEP + 'ms');
          el.classList.add('is-visible');
          el.querySelectorAll('[data-count]').forEach(countUp);
        }

        var io = new IntersectionObserver(function (entries) {
          var i = 0;
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            if (e.target.hasAttribute('data-reveal-group')) {
              e.target.querySelectorAll('[data-reveal]').forEach(function (child, j) { reveal(child, j); });
            } else {
              reveal(e.target, i++);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

        document.querySelectorAll('[data-count]').forEach(function (el) { el.textContent = '0'; });
        document.querySelectorAll('[data-reveal-group]').forEach(function (g) {
          if (g.scrollWidth > g.clientWidth + 1) io.observe(g);
          else g.removeAttribute('data-reveal-group');
        });
        document.querySelectorAll('[data-reveal]').forEach(function (el) {
          if (!el.closest('[data-reveal-group]')) io.observe(el);
        });
        root.dataset.motionReady = '1';
      })();
    </script>
  </body>
</html>
