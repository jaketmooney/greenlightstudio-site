---
import { getCollection } from 'astro:content';
import { featuredInOrder } from '../data/featured';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Jake from '../components/home/Jake.astro';
import Projects from '../components/home/Projects.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Services from '../components/home/Services.astro';
import Pricing from '../components/home/Pricing.astro';
import Team from '../components/home/Team.astro';
import ChannelVideos from '../components/home/ChannelVideos.astro';
import FaithBand from '../components/home/FaithBand.astro';
import Contact from '../components/home/Contact.astro';

// The INSIGHTS section and the "Get Jake's Take" block from the old Duda site
// are deliberately omitted: the blog is cut from this migration and /jake-take
// is deleted.
const featured = featuredInOrder(await getCollection('caseStudies'));
---

<BaseLayout
  title="Green Light Studio | Calm Marketing"
  description="Video and marketing support for marketing teams. We work alongside your marketing lead to achieve their goals every month."
  transparentHeader
>
  <Hero />
  <Jake />
  <Projects entries={featured} />
  <Testimonials />
  <Services />
  <Pricing />
  <Team />
  <ChannelVideos />
  <FaithBand />
  <Contact />
</BaseLayout>
