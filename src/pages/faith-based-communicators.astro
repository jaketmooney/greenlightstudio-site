---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VideoCard from '../components/VideoCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CompareSlider from '../components/CompareSlider.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import ChannelHeader from '../components/ChannelHeader.astro';
import ScrollRow from '../components/ScrollRow.astro';
import { place, placed } from '../lib/scroll-row';
import {
  CHANNELS,
  COMPARISONS,
  GALLERY_ROWS,
  GOSPELS_VIDEO,
  HERO_THUMBS,
  PROCESS,
  SERVICES,
  THUMBNAIL_CONCEPTS,
} from '../data/faith';
import { FAITH_TESTIMONIALS } from '../data/testimonials';
import { MIN_VIEWS_SHOWN } from '../data/videos';
import jakePortrait from '../assets/faith/jake-mooney.jpg';

// A page for a second audience: faith-based communicators on YouTube. It is
// linked from a slim band on the homepage and from the footer, but kept out
// of the header nav, which stays pointed at the manufacturing buyer.
const shownViews = (n: number) => (n >= MIN_VIEWS_SHOWN ? n : undefined);

const stats = [
  { value: 'Millions', label: "of views on videos we've worked on" },
  { value: '50+', label: 'interviews edited for Bible Memory Goal' },
  { value: '5', label: 'documentary episodes for The Historical Tell' },
  { value: '22', label: 'custom visuals designed for a single video' },
];
---

<BaseLayout
  title="Video for Faith-Based Communicators | Green Light Studio"
  description="Scripting, editing, visuals and thumbnails for thoughtful, faith-based communicators on YouTube, from the team behind videos with millions of views."
>
  {/* Hero */}
  <section class="relative isolate overflow-hidden bg-gls-green-dark px-4 py-20 text-white sm:py-24">
    <div
      class="absolute -top-40 right-0 -z-10 h-[28rem] w-[40rem] rounded-full bg-gls-green/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="font-semibold text-gls-yellow">For faith-based communicators</p>
        <h1 class="mt-3 font-heading text-4xl leading-tight font-bold text-balance sm:text-5xl">
          Helping thoughtful, faith-based communicators <span class="text-gls-yellow">reach larger audiences</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/85">
          We use our skills in scripting, visuals and production to help your message come across clearly, at a
          price that's affordable compared to domestic media agencies.
        </p>
        <a
          href="#contact"
          class="mt-8 inline-block rounded-md bg-gradient-to-r from-gls-green to-gls-yellow px-8 py-3 font-heading font-bold text-white shadow-lg transition hover:opacity-90 hover:shadow-xl motion-safe:hover:-translate-y-0.5"
        >
          Let's Talk
        </a>
      </div>

      {/* A loose mosaic of thumbnails from the work below. */}
      <div data-reveal class="grid grid-cols-2 gap-3 sm:gap-4">
        {
          HERO_THUMBS.map((t, i) => (
            <Image
              src={t.src}
              alt={t.alt}
              width={640}
              class:list={[
                'aspect-video w-full rounded-xl object-cover shadow-2xl ring-1 ring-white/10',
                { 'translate-y-6': i % 2 === 1 },
              ]}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* Proof */}
  <section class="bg-white px-4 py-14">
    <div class="mx-auto grid max-w-6xl gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div data-reveal>
            <p class="font-heading text-4xl font-bold text-gls-green-dark sm:text-5xl">{s.value}</p>
            <p class="mt-2 text-gls-ink/70">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* How we help */}
  <section class="bg-gls-paper px-4 py-20">
    <div class="mx-auto max-w-4xl">
      <SectionHeading heading="How we help" />
      <div data-reveal class="mx-auto mt-8 max-w-3xl text-center text-lg leading-relaxed">
        <p>
          We help script content, create visuals and produce high-value productions, at a price that's affordable
          compared to domestic media agencies.
        </p>
        <p class="mt-4">
          We've worked with enough communicators to know what's too much, what's not enough, and how to approach
          it. We're easy to work with, we're motivated, and we want to help these messages get out.
        </p>
      </div>
      <ul data-reveal class="mt-10 flex flex-wrap justify-center gap-3">
        {
          SERVICES.map((s) => (
            <li class="rounded-full bg-white px-4 py-2 font-semibold text-gls-green-dark shadow-sm ring-1 ring-gls-ink/5">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* The work, channel by channel */}
  <section class="bg-white px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading heading="Work we've been part of" />

      {
        CHANNELS.map((ch) =>
          ch.layout === 'wide' ? (
            <article class="mt-14 border-t border-gls-ink/10 pt-12">
              <ChannelHeader ch={ch} wide />
              <ScrollRow label={`${ch.name} videos`} class="mt-8">
                {ch.videos.map((v, i) => (
                  <div style={place(i, ch.videos.length)} class={placed}>
                    <VideoCard
                      id={v.id}
                      title={v.title}
                      label={v.label}
                      views={shownViews(v.views)}
                      note={v.note}
                      class="h-full"
                    />
                  </div>
                ))}
              </ScrollRow>
              {ch.shorts && (
                <>
                  <p class="mt-8 text-sm font-semibold tracking-wide text-gls-ink/60 uppercase">Shorts</p>
                  <ScrollRow label={`${ch.name} Shorts`} variant="shorts" class="mt-1">
                    {ch.shorts.map((v) => (
                      <VideoCard
                        id={v.id}
                        title={v.title}
                        views={shownViews(v.views)}
                        poster={v.poster}
                        vertical
                        class="h-full"
                      />
                    ))}
                  </ScrollRow>
                </>
              )}
            </article>
          ) : (
            <article class="mt-14 grid gap-8 border-t border-gls-ink/10 pt-12 lg:grid-cols-[1fr_2fr] lg:gap-12">
              <ChannelHeader ch={ch} />

              {/* An odd number of videos gives the first one the full width. */}
              <div class="grid min-w-0 gap-6 sm:grid-cols-2">
                {ch.videos.map((v, i) => (
                  <VideoCard
                    id={v.id}
                    title={v.title}
                    label={v.label}
                    views={shownViews(v.views)}
                    note={v.note}
                    class={ch.videos.length % 2 === 1 && i === 0 ? 'sm:col-span-2' : ''}
                  />
                ))}
                {ch.shorts && (
                  <div class="min-w-0 sm:col-span-2">
                    <p class="text-sm font-semibold tracking-wide text-gls-ink/60 uppercase">
                      {ch.shortsLabel ?? 'Shorts'}
                    </p>
                    <div class="-mx-4 mt-3 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 py-1 sm:mx-0 sm:grid sm:grid-cols-3 sm:gap-4 sm:overflow-visible sm:px-0">
                      {ch.shorts.map((v) => (
                        <VideoCard
                          id={v.id}
                          title={v.title}
                          views={shownViews(v.views)}
                          poster={v.poster}
                          vertical
                          class="w-[46%] shrink-0 snap-start sm:w-auto"
                        />
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </article>
          )
        )
      }
    </div>
  </section>

  {/* Behind the work: process */}
  <section class="bg-gls-paper px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading eyebrow="behind the work" heading="How an idea reaches the screen" />
      <p data-reveal class="mx-auto mt-6 max-w-2xl text-center text-lg leading-relaxed">
        Every step below comes from one project: Wes Huff's <em>{GOSPELS_VIDEO}</em>
      </p>
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS.map((p, i) => (
            <li data-reveal class="flex flex-col overflow-hidden rounded-xl bg-white shadow">
              <div class="aspect-[4/3] overflow-hidden bg-gls-ink/5">
                <Image src={p.image} alt={p.alt} width={600} class="h-full w-full object-cover object-top" />
              </div>
              <div class="flex-1 p-5">
                <p class="flex items-center gap-2 font-heading font-bold">
                  <span class="flex h-7 w-7 items-center justify-center rounded-full bg-gls-yellow text-sm text-gls-green-dark">
                    {i + 1}
                  </span>
                  {p.step}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-gls-ink/80">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Storyboard to screen */}
  <section class="bg-white px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading heading="From storyboard to screen" />
      <p data-reveal class="mx-auto mt-6 max-w-2xl text-center text-lg leading-relaxed">
        Drag across each frame to compare the sketch with the finished visual.
      </p>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {
          COMPARISONS.map((c) => (
            <CompareSlider
              before={c.before}
              after={c.after}
              label={c.label}
              beforeAlt={`Storyboard sketch: ${c.label}`}
              afterAlt={`Finished frame: ${c.label}`}
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* Thumbnail concepts */}
  <section class="bg-gls-paper px-4 py-20">
    <div class="mx-auto max-w-6xl">
      <SectionHeading heading="Twelve thumbnail concepts, one video" />
      <p data-reveal class="mx-auto mt-6 max-w-2xl text-center text-lg leading-relaxed">
        A thumbnail decides whether a video gets watched, so we explore widely. These are our concepts for
        <em> {GOSPELS_VIDEO}</em>; the highlighted one went live.
      </p>
      <div data-reveal class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
        {
          THUMBNAIL_CONCEPTS.map((t, i) => (
            <div
              class:list={[
                'relative overflow-hidden rounded-lg shadow',
                t.published ? 'ring-4 ring-gls-yellow' : 'opacity-90',
              ]}
            >
              <Image src={t.image} alt={`Thumbnail concept ${i + 1}`} width={480} class="aspect-video w-full object-cover" />
              {t.published && (
                <span class="absolute top-2 left-2 rounded-full bg-gls-yellow px-2.5 py-0.5 text-xs font-bold text-gls-green-dark shadow">
                  Published
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Style gallery */}
  <section class="bg-white py-20">
    <div class="mx-auto max-w-6xl px-4">
      <SectionHeading heading="Two films, two looks" />
      <p data-reveal class="mx-auto mt-6 max-w-2xl text-center text-lg leading-relaxed">
        Parchment, maps and data for the Gospels video. Candlelight, line art and classic paintings for the
        Prodigal video, built from 80 historical artworks and photographs.
        <span class="block text-sm text-gls-ink/60">
          <span class="sm:hidden">Tap</span><span class="hidden sm:inline">Click</span> any frame to see it full size.
        </span>
      </p>
    </div>
    <PhotoMarquee rows={GALLERY_ROWS} class="mt-10" />
  </section>

  {/* Testimonials */}
  <section class="relative isolate overflow-hidden bg-gls-green-dark px-4 py-20">
    <div class="mx-auto max-w-4xl">
      <SectionHeading heading="What they say about working with us" inverted />
      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        {
          FAITH_TESTIMONIALS.map((t) => (
            <div data-reveal>
              <TestimonialCard t={t} class="h-full" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Contact: Jake's own address here, at his request (the rest of the
      site links hello@). */}
  <section id="contact" class="bg-white px-4 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <SectionHeading heading="Have a message worth sharing?" />
      <p data-reveal class="mt-6 text-lg leading-relaxed">
        Tell us about your channel or project and who you're hoping to reach.
      </p>
    </div>

    <div
      data-reveal
      class="mx-auto mt-10 flex max-w-2xl flex-col items-center gap-6 rounded-2xl bg-gls-paper p-6 text-center sm:flex-row sm:p-8 sm:text-left"
    >
      <Image
        src={jakePortrait}
        alt="Jake Mooney, founder of Green Light Studio"
        width={400}
        height={400}
        class="h-36 w-36 shrink-0 rounded-full object-cover object-[50%_35%] ring-4 ring-white shadow-lg sm:h-40 sm:w-40"
      />
      <div>
        <p class="font-heading text-xl font-bold">Jake Mooney</p>
        <p class="text-gls-ink/70">Founder, Green Light Studio</p>
        <a
          href="mailto:jacob@greenlightstudio.co"
          class="mt-4 inline-block font-heading text-lg font-bold break-all text-gls-green-dark underline decoration-gls-yellow decoration-2 underline-offset-4 transition hover:text-gls-green sm:text-xl"
        >
          jacob@greenlightstudio.co
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
