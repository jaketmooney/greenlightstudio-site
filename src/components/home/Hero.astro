---
import { Image } from 'astro:assets';
import hero from '../../assets/home/hero.jpg';
---
<section class="relative isolate overflow-hidden bg-gls-green-dark">
  <Image
    src={hero}
    alt=""
    width={1920}
    height={1280}
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 -z-10 bg-black/50"></div>
  <div class="mx-auto flex min-h-[80vh] max-w-4xl flex-col items-center justify-center px-4 py-24 text-center text-white">
    <p class="font-heading text-2xl">Finally reach your marketing goals with</p>
    <h1 class="mt-2 font-heading text-4xl font-bold sm:text-5xl">
      <span class="text-gls-yellow">Custom marketing</span> support
    </h1>
    <p class="mt-6 max-w-xl text-lg">
      We support your team to implement the marketing that matters for your business.
    </p>
    <p class="mt-2 text-lg font-bold">On Time. On Budget. On Brand.</p>
    <a
      href="#contact-2026"
      class="mt-8 inline-block rounded-md bg-gradient-to-r from-gls-green to-gls-yellow px-8 py-3 font-heading font-bold text-white shadow-lg transition hover:opacity-90"
    >
      Let's Chat
    </a>
  </div>
</section>
