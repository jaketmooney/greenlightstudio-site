---
import { Image } from 'astro:assets';
import hero from '../../assets/home/hero.jpg';
---

{/* min-h-dvh, not min-h-screen: dvh tracks the *visible* viewport on mobile,
    so the hero is not cut off by the browser's collapsing address bar. */}
<section class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-gls-green-dark">
  {/* A phone shows only ~31% of this frame's width, so the crop window has to
      be placed deliberately: 42% puts the seated subject just right of centre
      across common phone sizes. Desktop shows enough of the frame that plain
      centring works. */}
  <Image
    src={hero}
    alt=""
    width={1920}
    height={1280}
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[42%_center] sm:object-center"
    loading="eager"
  />
  {/* Desktop: darken to the right, behind the copy, leaving the people clear.
      Mobile: darken upward from the bottom, where the copy sits. */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-black/10 sm:bg-gradient-to-r sm:from-black/25 sm:via-black/35 sm:to-black/70"
  >
  </div>

  {/* mt-auto pushes the copy to the bottom of the viewport, so the subject of
      the photograph stays visible in the space above it. */}
  <div class="mx-auto mt-auto w-full max-w-6xl px-4 pb-16 sm:pb-24">
    <div class="text-center text-white sm:ml-auto sm:max-w-xl sm:text-right">
      <p class="text-lg sm:text-2xl">Finally reach your marketing goals with</p>
      <h1 class="mt-2 font-heading text-4xl font-bold leading-tight sm:text-6xl">
        <span class="text-gls-yellow">Custom marketing</span> support
      </h1>
      <p class="mt-4 text-base sm:mt-6 sm:text-lg">
        We support your team to implement the marketing that matters for your business.
      </p>
      <p class="mt-2 text-base font-bold sm:text-lg">On Time. On Budget. On Brand.</p>
      <a
        href="#contact-2026"
        class="mt-6 inline-block rounded-md bg-gradient-to-r from-gls-green to-gls-yellow px-8 py-3 font-heading font-bold text-white shadow-lg transition hover:opacity-90 sm:mt-8"
      >
        Let's Chat
      </a>
    </div>
  </div>
</section>
