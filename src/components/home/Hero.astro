---
import { Image, getImage } from 'astro:assets';
import YouTube from '../YouTube.astro';
import HeroResults from './HeroResults.astro';
import brushStroke from '../../assets/home/brush-stroke.png';
import couch from '../../assets/home/hero.jpg';

// The hero does the persuading: the promise, one action, Jake's walkthrough
// video, and rotating results linking to their case studies. It replaced a
// full-screen photo in October 2026; that photo (Jake with a client) is now
// the video's cover, a calmer image than YouTube's text-heavy thumbnail.
//
// Variants. The site owner chose `card` (16 Oct 2026; his team found the
// all-green `dark` hero too much colour, and the card ties the hero to the
// next section's "15 years" card). The others are kept so they can be tried
// again. All but `dark` need the page's <BaseLayout headerOnLight> so the
// header switches to dark text.
//   dark  — all dark green
//   light — warm paper background, dark text, the brush stroke for emphasis
//   band  — white, with the results on a dark green band along the bottom
//   card  — white, with the results in a rounded dark green card, like the
//           "15 years" card in the next section
interface Props {
  variant?: 'dark' | 'light' | 'band' | 'card';
}
const { variant = 'dark' } = Astro.props;
const dark = variant === 'dark';

const poster = await getImage({ src: couch, width: 1280, height: 720, fit: 'cover', position: 'top', format: 'webp' });

const tone = {
  section: { dark: 'bg-gls-green-dark text-white', light: 'bg-gls-paper text-gls-ink', band: 'bg-white text-gls-ink', card: 'bg-white text-gls-ink' }[variant],
  h1: dark ? 'text-white' : 'text-gls-green-dark',
  sub: dark ? 'text-white/80' : 'text-gls-ink/75',
  link: dark ? 'text-white/90 hover:text-gls-yellow' : 'text-gls-green-dark hover:text-gls-green',
  caption: dark ? 'text-white/60' : 'text-gls-ink/55',
};
// The results row: on the dark hero and on the band it's light-on-dark.
const proofOnDark = variant !== 'light';
---

<section class:list={['relative isolate overflow-hidden px-4 pt-28 sm:pt-32', tone.section, variant === 'band' || variant === 'card' ? 'pb-0' : 'pb-14 lg:pb-16']}>
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[5fr_6fr] lg:gap-14">
    <div>
      <h1 class:list={['font-heading text-4xl leading-tight font-bold text-balance sm:text-[2.75rem]', tone.h1]}>
        {dark ? <span class="text-gls-yellow">Marketing &amp; Media Support</span> : 'Marketing & Media Support'} for Busy
        Marketing Teams
      </h1>
      {!dark && <Image src={brushStroke} alt="" width={230} height={27} class="mt-2 -ml-1" />}
      <p class:list={['mt-5 max-w-xl text-lg leading-relaxed', tone.sub]}>
        We work alongside your marketing lead to achieve their goals every month.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href="#contact-2026"
          class="inline-block rounded-md bg-gradient-to-r from-gls-green to-gls-yellow px-8 py-3 font-heading font-bold text-white shadow-lg transition hover:opacity-90 hover:shadow-xl motion-safe:hover:-translate-y-0.5"
        >
          Let's Talk
        </a>
        <a href="#projects" class:list={['group inline-flex items-center gap-1.5 font-heading font-bold transition', tone.link]}>
          See our work
          <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 transition motion-safe:group-hover:translate-y-0.5" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M10 3a.75.75 0 0 1 .75.75v10.69l3.22-3.22a.75.75 0 1 1 1.06 1.06l-4.5 4.5a.75.75 0 0 1-1.06 0l-4.5-4.5a.75.75 0 1 1 1.06-1.06l3.22 3.22V3.75A.75.75 0 0 1 10 3Z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>

    <figure>
      <div class:list={['overflow-hidden rounded-xl shadow-xl [&_lite-youtube]:max-w-none', dark ? 'ring-1 ring-white/10' : 'ring-1 ring-black/5']}>
        <YouTube id="Txas4ESKQ5I" title="Extending Your Marketing Team with Green Light Studio" poster={poster.src} />
      </div>
      <figcaption class:list={['mt-3 text-sm', tone.caption]}>
        Watch Jake's full walkthrough of how we work (24 min)
      </figcaption>
    </figure>
  </div>

  {/* Results: three slots taking turns to pop to the next result (HeroResults). */}
  <div
    class:list={[
      variant === 'band' && '-mx-4 mt-14 bg-gls-green-dark px-4 py-8 text-white lg:mt-16',
      variant === 'card' && 'mx-auto mt-12 max-w-6xl rounded-2xl bg-gls-green-dark px-6 py-8 text-white sm:px-10 lg:mt-14',
      (dark || variant === 'light') && 'mt-12 lg:mt-14',
    ]}
  >
    <HeroResults
      onDark={proofOnDark}
      class={[
        'mx-auto max-w-6xl',
        variant !== 'band' && variant !== 'card' && 'border-t pt-8',
        proofOnDark ? 'border-white/15' : 'border-gls-ink/10',
      ]
        .filter(Boolean)
        .join(' ')}
    />
  </div>
</section>
