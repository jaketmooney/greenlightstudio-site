---
import { Image } from 'astro:assets';
import jake from '../../assets/home/jake-portrait.jpg';

const points = [
  'A team that gets to know your business',
  "Strategy that's practical for your industry",
  'Consistent, reliable implementation',
  'Flexibility when something unexpected comes up',
];
---

<section class="bg-white px-4 py-20">
  <div class="mx-auto grid max-w-5xl items-center gap-10 sm:grid-cols-2">
    <div>
      <h2 class="font-heading text-3xl font-bold leading-tight text-gls-green-dark sm:text-4xl">
        I'm Jake.<br />I've been there.
      </h2>
      <p class="mt-6 leading-relaxed">
        Small marketing teams are often expected to support a surprisingly large organization.
      </p>
      <p class="mt-4 leading-relaxed">
        We built Green Light Studio to give those teams the kind of flexible, reliable support
        that's hard to hire for internally.
      </p>

      <ul class="mt-6 space-y-3">
        {
          points.map((point) => (
            <li class="flex items-start gap-3">
              <svg
                viewBox="0 0 20 20"
                fill="currentColor"
                class="mt-1 h-4 w-4 shrink-0 text-gls-green"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <a
        href="#contact-2026"
        class="mt-8 inline-block rounded-md bg-gradient-to-r from-gls-green to-gls-yellow px-8 py-3 font-heading font-bold text-white shadow transition hover:opacity-90"
      >
        Let's Talk
      </a>
    </div>

    <div class="text-center">
      {/* 3:2 source cropped square, so object-right centres the subject.
          See the gls-website skill for the reasoning. */}
      <Image
        src={jake}
        alt="Jake Mooney, founder of Green Light Studio"
        width={600}
        height={600}
        class="mx-auto aspect-square w-full max-w-[600px] rounded-2xl object-cover object-right shadow-lg"
      />
      <p class="mt-4 font-heading font-bold">Jake Mooney</p>
      <p class="text-sm text-gls-ink/70">Founder &middot; Green Light Studio</p>
    </div>
  </div>
</section>
