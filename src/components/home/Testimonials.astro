---
import SectionHeading from '../SectionHeading.astro';

// Quotes are verbatim from the clients. The first is the longest and the one
// that names outcomes, so it gets the large card; the rest stack beside it.
const [featured, ...others] = [
  {
    quote:
      "Jake took over things I didn't have time for while giving our website and campaigns a much-needed update. Now our ads bring in revenue, and the website sells effectively.",
    name: 'Burl Tichenor',
    company: 'Digital Wood Carver',
  },
  {
    quote: "They're proactive, quick to respond, and always ready for anything.",
    name: 'Paulina Lewandowska',
    company: 'Ziegler Group',
  },
  {
    quote:
      'The GLS team is friendly, knowledgeable, and efficient. They keep you in the loop and work quickly.',
    name: 'Beth Tichenor',
    company: 'Digital Wood Carver',
  },
  {
    quote:
      "We've appreciated Green Light Studio's flexibility, responsiveness, and ability to support our changing needs…",
    name: 'Anthony Robinson',
    company: 'ForestNet Media',
  },
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');

const quoteMark =
  'M0 24V14.4C0 6.4 4.8 1.6 12 0l1.6 3.2C9.2 4.8 7.2 8 7.2 12H12v12H0Zm19.2 0V14.4c0-8 4.8-12.8 12-14.4l1.6 3.2c-4.4 1.6-6.4 4.8-6.4 8.8h4.8v12H19.2Z';
---

<section id="testimonials" class="relative isolate overflow-hidden bg-gls-green-dark px-4 py-20">
  {/* A soft glow in the brand green keeps the dark band from reading flat. */}
  <div
    class="absolute -top-40 left-1/2 -z-10 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-gls-green/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl">
    <SectionHeading heading="What clients say about working with us" inverted />

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      <figure class="flex flex-col rounded-2xl bg-white p-8 shadow-xl sm:p-10 lg:row-span-3">
        <div class="flex flex-1 flex-col justify-center">
          <svg viewBox="0 0 33 24" class="h-10 w-14 text-gls-yellow" fill="currentColor" aria-hidden="true">
            <path d={quoteMark} />
          </svg>
          <blockquote class="mt-6 font-heading text-2xl font-medium leading-snug text-gls-ink sm:text-3xl">
            <p>{featured.quote}</p>
          </blockquote>
        </div>
        <figcaption class="mt-10 flex items-center gap-4 border-t border-gls-ink/10 pt-6">
          <span
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gls-green-dark font-heading font-bold text-gls-yellow"
            aria-hidden="true"
          >
            {initials(featured.name)}
          </span>
          <span>
            <span class="block font-heading font-bold text-gls-ink">{featured.name}</span>
            <span class="text-sm text-gls-ink/70">{featured.company}</span>
          </span>
        </figcaption>
      </figure>

      {
        others.map((t) => (
          <figure class="flex flex-col justify-between rounded-2xl bg-white/[0.06] p-7 ring-1 ring-white/10">
            <div class="flex gap-4">
              <svg
                viewBox="0 0 33 24"
                class="mt-1 h-5 w-7 shrink-0 text-gls-yellow"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={quoteMark} />
              </svg>
              <blockquote class="text-lg leading-relaxed text-white">
                <p>{t.quote}</p>
              </blockquote>
            </div>
            <figcaption class="mt-5 flex items-center gap-3 pl-11">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gls-yellow font-heading text-sm font-bold text-gls-green-dark"
                aria-hidden="true"
              >
                {initials(t.name)}
              </span>
              <span>
                <span class="block font-heading font-bold text-white">{t.name}</span>
                <span class="text-sm text-white/70">{t.company}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
