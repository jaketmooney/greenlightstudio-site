---
import SectionHeading from '../SectionHeading.astro';
import DriftCarousel from '../DriftCarousel.astro';
import TestimonialCard from '../TestimonialCard.astro';
import { TESTIMONIALS } from '../../data/testimonials';

// Client testimonials as a slow-drifting row (DriftCarousel) of
// TestimonialCards. Quotes and order live in src/data/testimonials.ts.
---

<section id="testimonials" class="relative isolate overflow-hidden bg-gls-green-dark px-4 py-20">
  {/* A soft glow in the brand green keeps the dark band from reading flat. */}
  <div
    class="absolute -top-40 left-1/2 -z-10 h-96 w-[48rem] -translate-x-1/2 rounded-full bg-gls-green/20 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl">
    <SectionHeading heading="What clients say about working with us" inverted />

    <DriftCarousel label="testimonials" speed={20} class="mt-14">
      {
        TESTIMONIALS.map((t) => (
          <TestimonialCard t={t} class="w-[85%] sm:w-[340px] lg:w-[360px]" />
        ))
      }
    </DriftCarousel>
  </div>
</section>
