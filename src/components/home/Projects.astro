---
import type { CollectionEntry } from 'astro:content';
import CaseStudyCard from '../CaseStudyCard.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props { entries: CollectionEntry<'caseStudies'>[] }
const { entries } = Astro.props;
---
<section id="projects" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <SectionHeading heading="Our Clients" />
    <p class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed">
      What we've done for marketing teams like yours.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </div>
</section>
