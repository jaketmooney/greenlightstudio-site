---
import type { CollectionEntry } from 'astro:content';
import CaseStudyCard from '../CaseStudyCard.astro';
import SectionHeading from '../SectionHeading.astro';
import VideoCard from '../VideoCard.astro';
import PhotoMarquee from '../PhotoMarquee.astro';
import { MIN_VIEWS_SHOWN, PRODUCED_VIDEOS, SHORTS } from '../../data/videos';

interface Props { entries: CollectionEntry<'caseStudies'>[] }
const { entries } = Astro.props;

const shownViews = (n: number) => (n >= MIN_VIEWS_SHOWN ? n : undefined);

// Desktop: five videos on a six-column grid, two wide cards then three
// narrower ones, so the last row is full rather than leaving a gap. Below lg
// they swipe sideways like the Shorts, which keeps a phone from scrolling
// through five full-width videos.
const span = (i: number) => (i < 2 ? 'lg:col-span-3' : 'lg:col-span-2');
---
<section id="projects" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <SectionHeading heading="Our Clients" />
    <p data-reveal class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed text-balance">
      What we've done for marketing teams like yours.
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>

    {/* The videos stay inside this section, under a lighter divider heading
        rather than a SectionHeading, so they read as more of the portfolio. */}
    <div data-reveal class="mt-20 flex items-center gap-4 sm:gap-6">
      <span class="h-px flex-1 bg-gls-ink/15"></span>
      <h3 class="font-heading text-2xl font-bold sm:text-3xl">Videos we've produced</h3>
      <span class="h-px flex-1 bg-gls-ink/15"></span>
    </div>

    <div data-reveal-group class="-mx-4 mt-10 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 py-2 lg:mx-0 lg:grid lg:grid-cols-6 lg:gap-8 lg:overflow-visible lg:px-0">
      {
        PRODUCED_VIDEOS.map((v, i) => (
          <VideoCard
            id={v.id}
            title={v.title}
            label={v.client}
            views={shownViews(v.views)}
            large={i < 2}
            class={`w-[85%] shrink-0 snap-start sm:w-[46%] lg:w-auto ${span(i)}`}
          />
        ))
      }
    </div>

    <h4 data-reveal class="mt-14 text-center font-heading text-xl font-bold">Shorts</h4>

    {/* Phones and tablets scroll the row sideways; desktop fits all five. */}
    <div
      data-reveal-group
      class="-mx-4 mt-6 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 py-2 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-6 lg:overflow-visible lg:px-0"
    >
      {
        SHORTS.map((v) => (
          <VideoCard
            id={v.id}
            title={v.title}
            label={v.client}
            views={shownViews(v.views)}
            poster={v.poster}
            vertical
            class="w-[46%] shrink-0 snap-start sm:w-[30%] lg:w-auto"
          />
        ))
      }
    </div>

    <h4 data-reveal class="mt-14 text-center font-heading text-xl font-bold">From our shoots</h4>
    <p data-reveal class="mt-1 text-center text-sm text-gls-ink/60">
      <span class="sm:hidden">Tap</span><span class="hidden sm:inline">Click</span> any photo to see it
      full size.
    </p>
  </div>

  {/* Full-bleed: -mx-4 cancels the section's side padding. */}
  <PhotoMarquee class="-mx-4 mt-6" />
</section>
