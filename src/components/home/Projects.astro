---
import type { CollectionEntry } from 'astro:content';
import CaseStudyCard from '../CaseStudyCard.astro';
import SectionHeading from '../SectionHeading.astro';

interface Props { entries: CollectionEntry<'caseStudies'>[] }
const { entries } = Astro.props;
---
<section id="projects" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    {/* No eyebrow here: the heading is a full statement on its own, and
        "some of our" read oddly in front of it. */}
    <SectionHeading heading="Real Work For Real Marketing Teams" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </div>
</section>
