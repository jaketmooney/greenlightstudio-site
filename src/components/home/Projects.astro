---
import type { CollectionEntry } from 'astro:content';
import CaseStudyCard from '../CaseStudyCard.astro';
import SectionHeading from '../SectionHeading.astro';
import VideoCard from '../VideoCard.astro';
import PhotoMarquee from '../PhotoMarquee.astro';
import ShortsCarousel from '../ShortsCarousel.astro';
import ScrollRow from '../ScrollRow.astro';
import { MIN_VIEWS_SHOWN, PRODUCED_VIDEOS } from '../../data/videos';

interface Props { entries: CollectionEntry<'caseStudies'>[] }
const { entries } = Astro.props;

const shownViews = (n: number) => (n >= MIN_VIEWS_SHOWN ? n : undefined);

// A two-row scroller naturally fills top-to-bottom, which would scramble the
// editorial order. Instead each card is placed so every screenful of three
// columns reads left to right, top row first (1 2 3 / 4 5 6, then 7 8 9 /
// 10 11 12). A short last page of three or fewer fills column by column so it
// doesn't leave a hole. Applied from sm up; phones keep the plain order.
function place(i: number, n: number) {
  const page = Math.floor(i / 6);
  const j = i % 6;
  const rest = n - page * 6;
  const { r, c } =
    rest <= 3
      ? { r: (j % 2) + 1, c: Math.floor(j / 2) + 1 }
      : { r: j < 3 ? 1 : 2, c: (j % 3) + 1 };
  return `--r: ${r}; --c: ${page * 3 + c}`;
}
const placed = 'sm:[grid-row:var(--r)] sm:[grid-column:var(--c)]';
---
<section id="projects" class="px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <SectionHeading heading="Our Clients" />
    <p data-reveal class="mx-auto mt-4 max-w-2xl text-center text-lg leading-relaxed text-balance">
      What we've done for marketing teams like yours.
    </p>

    {/* Case studies and videos each show at most two rows; the rest scroll
        sideways (one swipeable row on phones). See ScrollRow. */}
    <ScrollRow label="case studies" class="mt-10">
      {
        entries.map((entry, i) => (
          <div style={place(i, entries.length)} class={placed}>
            <CaseStudyCard entry={entry} class="h-full" />
          </div>
        ))
      }
    </ScrollRow>

    {/* The videos stay inside this section, under a lighter divider heading
        rather than a SectionHeading, so they read as more of the portfolio. */}
    <div data-reveal class="mt-20 flex items-center gap-4 sm:gap-6">
      <span class="h-px flex-1 bg-gls-ink/15"></span>
      <h3 class="font-heading text-2xl font-bold sm:text-3xl">Videos we've produced</h3>
      <span class="h-px flex-1 bg-gls-ink/15"></span>
    </div>

    <ScrollRow label="videos" class="mt-8">
      {
        PRODUCED_VIDEOS.map((v, i) => (
          <div style={place(i, PRODUCED_VIDEOS.length)} class={placed}>
            <VideoCard
              id={v.id}
              title={v.title}
              label={v.client}
              views={shownViews(v.views)}
              poster={v.poster}
              class="h-full"
            />
          </div>
        ))
      }
    </ScrollRow>

    <h4 data-reveal class="mt-14 text-center font-heading text-xl font-bold">Shorts</h4>

    <div class="mt-6">
      <ShortsCarousel />
    </div>

    <h4 data-reveal class="mt-14 text-center font-heading text-xl font-bold">Our Team in Action</h4>
    <p data-reveal class="mt-1 text-center text-sm text-gls-ink/60">
      <span class="sm:hidden">Tap</span><span class="hidden sm:inline">Click</span> any photo to see it
      full size.
    </p>
  </div>

  {/* Full-bleed: -mx-4 cancels the section's side padding. */}
  <PhotoMarquee class="-mx-4 mt-6" />
</section>
