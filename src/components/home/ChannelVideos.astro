---
import SectionHeading from '../SectionHeading.astro';
import VideoCard from '../VideoCard.astro';

// Jake's own videos, chosen for marketing leads at manufacturers and B2B
// companies: an overloaded marketing manager, expanding into a new market,
// and the calm-marketing talk. Titles match YouTube. (Replaced three older
// videos aimed at small-business owners, October 2026.)
const videos = [
  { id: '33677CZ53gc', title: 'Before You Quit Your Marketing Job, Watch This' },
  { id: 'byRfPLzaK8M', title: 'How NOT to Enter a New Industry' },
  { id: 'rEODKPDJ4V8', title: 'The “Calm Marketing” Approach Most Businesses Never Try' },
];
---

<section id="channel" class="bg-gls-paper px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <SectionHeading eyebrow="from our YouTube channel" heading="Advice for marketing leaders" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        videos.map((v, i) => (
          <VideoCard
            id={v.id}
            title={v.title}
            label="Jake Mooney"
            class={i === videos.length - 1 ? 'sm:col-span-2 sm:mx-auto sm:w-1/2 lg:col-span-1 lg:w-auto' : ''}
          />
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://www.youtube.com/@greenlightyourmarketing"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-md border-2 border-gls-green px-6 py-2.5 font-heading font-bold text-gls-green-dark transition hover:bg-gls-green hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z" />
        </svg>
        More on our YouTube channel
      </a>
    </div>
  </div>
</section>
