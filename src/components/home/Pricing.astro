---
import SectionHeading from '../SectionHeading.astro';

// Illustrative US ranges supplied by the site owner (October 2026), to be
// checked against published salary and agency-pricing sources. Both upper
// ends are open ("+"); the scale stops at $20k+.
const SCALE = 20_000;
const RANGES = [
  { label: 'US marketing agency', note: 'Ongoing multi-channel support', low: 5_000, high: 20_000 },
  { label: 'Full-time US marketing hire', note: 'Including employer expenses', low: 6_000, high: 12_000 },
];
const GLS = 3_500;
const TICKS = [0, 5_000, 10_000, 15_000, 20_000];

const pct = (n: number) => `${(n / SCALE) * 100}%`;
const usd = (n: number) => `$${n.toLocaleString('en-US')}`;

const hireCosts = ['Salary', 'Benefits', 'Payroll tax', 'Equipment'];
const skills = ['Video', 'Design', 'Social', 'Writing', 'Strategy'];
---

<section id="pricing" class="bg-white px-4 py-20">
  <div class="mx-auto max-w-5xl">
    <SectionHeading heading="Pricing" />

    <p data-reveal class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed sm:text-center">
      Hiring an experienced US marketing professional can cost $6,000–$12,000+ per month, including
      employer expenses. Ongoing agency support can cost $5,000–$20,000+.
    </p>
    <p data-reveal class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed sm:text-center">
      Green Light Studio engagements start around <strong class="font-semibold">$3,500/month</strong>,
      with an experienced team behind you.
    </p>

    <div data-reveal class="mt-12 rounded-2xl bg-gls-paper p-6 sm:p-10">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="text-sm font-semibold uppercase tracking-wide text-gls-ink/60">Monthly cost (USD)</p>
        <p class="text-sm text-gls-ink/50">Illustrative ranges</p>
      </div>

      {/* Floating range bars: each competitor's bar runs from its low to its
          high end, so the whole range reads as one thing. GLS is a marker at
          its starting price, and a dashed line carries that price down through
          every row (desktop) or marks it inside each bar (phones). Rows are a
          label column plus a track column; the overlay and axis line up with
          the track column via the same 15.5rem offset. */}
      <div class="relative mt-8">
        <div class="pointer-events-none absolute inset-y-0 right-0 hidden sm:left-[15.5rem] sm:block" aria-hidden="true">
          <span
            class="absolute -top-7 -translate-x-1/2 rounded-full bg-gls-green px-2.5 py-0.5 text-xs font-bold whitespace-nowrap text-white"
            style={{ left: pct(GLS) }}
          >
            {usd(GLS)}
          </span>
          <span class="absolute top-0 bottom-6 border-l-2 border-dashed border-gls-green" style={{ left: pct(GLS) }}></span>
        </div>

        <div class="space-y-8">
          {
            RANGES.map((r, i) => (
              <div class="sm:grid sm:grid-cols-[14rem_1fr] sm:items-center sm:gap-6">
                <div>
                  <p class="font-heading font-bold">{r.label}</p>
                  <p class="text-sm text-gls-ink/60">{r.note}</p>
                  <p class="mt-1 font-heading text-xl font-bold">{usd(r.low)}–{usd(r.high)}+</p>
                </div>
                <div
                  class="relative mt-3 h-6 rounded-[4px] bg-gls-ink/[0.06] sm:mt-0"
                  role="img"
                  aria-label={`${r.label}: ${usd(r.low)} to ${usd(r.high)} or more a month`}
                >
                  <span
                    data-bar
                    class="absolute inset-y-0 flex items-center justify-end rounded-[4px] bg-gls-ink/45 pr-1.5 text-white"
                    style={{ left: pct(r.low), width: pct(r.high - r.low), '--bar-delay': `${400 + i * 250}ms` }}
                  >
                    {/* Open-ended upper bound ("+"). */}
                    <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M7 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                  <span
                    class="absolute -inset-y-1 border-l-2 border-dashed border-gls-green sm:hidden"
                    style={{ left: pct(GLS) }}
                    aria-hidden="true"
                  ></span>
                </div>
              </div>
            ))
          }

          <div class="sm:grid sm:grid-cols-[14rem_1fr] sm:items-center sm:gap-6">
            <div>
              <p class="font-heading font-bold text-gls-green-dark">Green Light Studio</p>
              <p class="text-sm text-gls-ink/60">Experienced team support</p>
              <p class="mt-1 font-heading text-xl font-bold text-gls-green-dark">
                <span class="font-body text-sm font-normal text-gls-ink/60">Starting around</span>
                {usd(GLS)}
              </p>
            </div>
            <div
              class="relative mt-3 h-6 rounded-[4px] bg-gls-ink/[0.06] sm:mt-0"
              role="img"
              aria-label={`Green Light Studio: starting around ${usd(GLS)} a month`}
            >
              <span
                data-bar
                class="absolute top-1/2 h-7 w-7 -translate-x-1/2 -translate-y-1/2 rounded-full bg-gls-green shadow ring-4 ring-gls-paper"
                style={{ left: pct(GLS), '--bar-delay': '1000ms' }}
              ></span>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-6 border-t border-gls-ink/15 pt-2 text-xs text-gls-ink/50 sm:ml-[15.5rem]" aria-hidden="true">
          {
            TICKS.map((t, i) => (
              <span
                class:list={[
                  'absolute top-2',
                  i === 0 ? '' : i === TICKS.length - 1 ? '-translate-x-full' : '-translate-x-1/2',
                ]}
                style={{ left: pct(t) }}
              >
                {t === 0 ? '$0' : `$${t / 1000}k${t === SCALE ? '+' : ''}`}
              </span>
            ))
          }
        </div>
      </div>

      <p class="mt-6 text-xs leading-relaxed text-gls-ink/55">
        Illustrative US market ranges. Actual costs vary by location, experience, services, and scope. GLS
        pricing varies by engagement.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6">
        <div class="rounded-xl bg-white p-6">
          <div class="flex items-center gap-3">
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6 text-gls-ink/50"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke-linecap="round"></path>
            </svg>
            <h3 class="font-heading text-lg font-bold">One full-time hire</h3>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-gls-ink/50">
            Monthly cost includes
          </p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              hireCosts.map((c) => (
                <li class="rounded-full bg-gls-ink/[0.07] px-3 py-1 text-sm font-semibold text-gls-ink/80">
                  {c}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-xl bg-gls-green-dark p-6 text-white shadow-lg">
          <div class="flex items-center gap-3">
            <svg
              viewBox="0 0 24 24"
              class="h-6 w-6 text-gls-yellow"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="9" cy="8" r="3.5"></circle>
              <path d="M2.5 20c0-3.6 2.9-6.5 6.5-6.5s6.5 2.9 6.5 6.5" stroke-linecap="round"></path>
              <circle cx="17" cy="7" r="2.5"></circle>
              <path d="M17.5 12.5c2.5.3 4 2.6 4 5.5" stroke-linecap="round"></path>
            </svg>
            <h3 class="font-heading text-lg font-bold">An experienced, flexible team</h3>
          </div>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-white/60">
            Abilities across
          </p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {
              skills.map((s) => (
                <li class="rounded-full bg-white/10 px-3 py-1 text-sm font-semibold">{s}</li>
              ))
            }
            <li class="rounded-full bg-gls-yellow px-3 py-1 text-sm font-semibold text-gls-green-dark">
              and beyond
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a
        href="#contact-2026"
        class="inline-block rounded-md bg-gls-green px-8 py-3 font-heading font-bold text-white shadow transition hover:bg-gls-green-dark hover:shadow-lg motion-safe:hover:-translate-y-0.5"
      >
        Let's Chat
      </a>
    </div>
  </div>
</section>
