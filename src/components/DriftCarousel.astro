---
// A row that drifts slowly sideways on desktop, with arrow buttons to jump
// ahead or back. It pauses on hover or keyboard focus and stops for good once
// a video inside it is played. Phones and tablets swipe it instead. It
// scrolls (rather than sliding with a transform) so the arrows, trackpads and
// drag all keep working. Used for the Shorts and the testimonials.
//
// Each slotted child is one item and sets its own width. On desktop the
// items are rendered twice and the row wraps back by exactly one copy's
// width, so the loop has no end; the copy is hidden below lg.
interface Props {
  /** Names the arrow buttons, e.g. "Shorts" → "Previous Shorts" / "More Shorts". */
  label: string;
  /** Pixels per second. */
  speed?: number;
  class?: string;
}
const { label, speed = 28, class: className } = Astro.props;
const items = await Astro.slots.render('default');
---

<div class:list={['relative', className]} data-drift data-speed={speed}>
  <div
    data-track
    data-reveal-group
    class="drift-track -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 py-2 lg:mx-0 lg:snap-none lg:gap-6 lg:px-0"
  >
    <Fragment set:html={items} />
    <div data-copy class="hidden lg:contents"><Fragment set:html={items} /></div>
  </div>

  {
    [
      { dir: 'prev', text: `Previous ${label}`, side: 'left-0 -translate-x-1/2', d: 'M15 5l-7 7 7 7' },
      { dir: 'next', text: `More ${label}`, side: 'right-0 translate-x-1/2', d: 'M9 5l7 7-7 7' },
    ].map((b) => (
      <button
        type="button"
        data-dir={b.dir}
        aria-label={b.text}
        class:list={[
          'absolute top-[42%] z-10 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white text-gls-green-dark shadow-lg transition hover:bg-gls-yellow lg:flex',
          b.side,
        ]}
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d={b.d} stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    ))
  }
</div>

<style>
  .drift-track {
    scrollbar-width: none;
  }
  .drift-track::-webkit-scrollbar {
    display: none;
  }
  .drift-track > :global(*:not([data-copy])),
  .drift-track > [data-copy] > :global(*) {
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  @media (min-width: 1024px) {
    .drift-track {
      mask-image: linear-gradient(to right, transparent, #000 3%, #000 97%, transparent);
    }
  }
</style>

<script>
  const desktop = matchMedia('(min-width: 1024px)');
  const calm = matchMedia('(prefers-reduced-motion: no-preference)');

  document.querySelectorAll<HTMLElement>('[data-drift]').forEach((root) => {
    const speed = Number(root.dataset.speed) || 28;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const copy = track.querySelector<HTMLElement>('[data-copy]')!;
    const first = track.firstElementChild as HTMLElement;
    const copyFirst = copy.firstElementChild as HTMLElement;
    // One copy's width: from the first original item to the first duplicate.
    const period = () => copyFirst.offsetLeft - first.offsetLeft;

    // Keyboard and screen-reader users get each item once.
    copy.setAttribute('aria-hidden', 'true');
    const quiet = () =>
      copy.querySelectorAll('a, button, [tabindex]').forEach((el) => el.setAttribute('tabindex', '-1'));
    quiet();
    customElements.whenDefined('lite-youtube').then(quiet);

    let hovering = false;
    let played = false;
    let visible = false;
    let holdUntil = 0;
    let pos = track.scrollLeft;
    let lastSet = -1;
    let lastT = 0;

    root.addEventListener('mouseenter', () => (hovering = true));
    root.addEventListener('mouseleave', () => (hovering = false));
    root.addEventListener('focusin', () => (hovering = true));
    root.addEventListener('focusout', () => (hovering = false));
    track.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('lite-youtube')) played = true;
    });
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(root);

    root.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((button) =>
      button.addEventListener('click', () => {
        const p = period();
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const step = (first.offsetWidth + gap) * 2;
        // Jump by one copy first when near either end, so there's always room.
        if (button.dataset.dir === 'next' && track.scrollLeft >= p) track.scrollLeft -= p;
        if (button.dataset.dir === 'prev' && track.scrollLeft < step) track.scrollLeft += p;
        track.scrollBy({ left: button.dataset.dir === 'next' ? step : -step, behavior: 'smooth' });
        holdUntil = performance.now() + 2500;
      })
    );

    function tick(t: number) {
      const dt = lastT ? Math.min(t - lastT, 50) / 1000 : 0;
      lastT = t;
      const running = desktop.matches && calm.matches && visible && !hovering && !played && t > holdUntil;
      if (running) {
        // If someone scrolled it by hand, carry on from where they left it.
        if (Math.abs(track.scrollLeft - lastSet) > 2) pos = track.scrollLeft;
        pos += speed * dt;
        const p = period();
        if (pos >= p) pos -= p;
        track.scrollLeft = pos;
        lastSet = track.scrollLeft;
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  });
</script>
