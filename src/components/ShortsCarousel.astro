---
import DriftCarousel from './DriftCarousel.astro';
import VideoCard from './VideoCard.astro';
import { MIN_VIEWS_SHOWN, SHORTS } from '../data/videos';

// The Shorts row: drifts on desktop, swipes on phones (see DriftCarousel).
const shownViews = (n: number) => (n >= MIN_VIEWS_SHOWN ? n : undefined);
---

<DriftCarousel label="Shorts">
  {
    SHORTS.map((v) => (
      <div class="w-[46%] sm:w-[30%] lg:w-[220px]">
        <VideoCard
          id={v.id}
          title={v.title}
          label={v.client}
          views={shownViews(v.views)}
          poster={v.poster}
          vertical
          class="h-full"
        />
      </div>
    ))
  }
</DriftCarousel>
