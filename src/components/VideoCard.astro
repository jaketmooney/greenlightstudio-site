---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YouTube from './YouTube.astro';
import { formatViews } from '../data/videos';

// A playable video in the same card as CaseStudyCard, so the videos read as
// part of the portfolio rather than a separate block.
interface Props {
  id: string;
  title: string;
  /** Small green line above the title, like a case study's client. */
  label?: string;
  views?: number;
  /** Local thumbnail: Shorts need one (YouTube's are 4:3); others may replace YouTube's. */
  poster?: ImageMetadata;
  vertical?: boolean;
  /** Larger title for the wider cards. */
  large?: boolean;
  class?: string;
}
const { id, title, label, views, poster, vertical = false, large = false, class: className } =
  Astro.props;
const posterUrl = poster
  ? (await getImage({ src: poster, width: Math.min(vertical ? 480 : 800, poster.width), format: 'webp' })).src
  : undefined;
---

<article data-reveal class:list={['flex flex-col overflow-hidden rounded-lg bg-white shadow transition hover:shadow-xl motion-safe:hover:-translate-y-1', className]}>
  <YouTube id={id} title={title} poster={posterUrl} vertical={vertical} />
  <div class:list={['flex flex-1 flex-col', vertical ? 'p-4' : 'p-5']}>
    {
      (label || views !== undefined) && (
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
          {label && <p class="text-sm font-semibold text-gls-green">{label}</p>}
          {views !== undefined && (
            <p class="flex items-center gap-1.5 rounded-full bg-gls-yellow/25 px-2.5 py-0.5 text-sm font-bold text-gls-green-dark">
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path d="M10 4C5.5 4 2 8.5 1.2 9.6a.7.7 0 0 0 0 .8C2 11.5 5.5 16 10 16s8-4.5 8.8-5.6a.7.7 0 0 0 0-.8C18 8.5 14.5 4 10 4Zm0 9.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0-5.25a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5Z" />
              </svg>
              {formatViews(views)}
            </p>
          )}
        </div>
      )
    }
    <h3 class:list={['mt-1', large ? 'text-lg sm:text-xl' : vertical ? 'text-base leading-snug' : 'text-lg']}>
      {title}
    </h3>
  </div>
</article>
