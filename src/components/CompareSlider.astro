---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Before/after: the finished frame sits over the storyboard sketch and is
// revealed up to a divider. A native range input drives it, so mouse, touch
// and keyboard (arrow keys) all work without extra handling.
interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  label: string;
  /** Where the divider starts, 0-100. */
  start?: number;
}
const { before, after, beforeAlt, afterAlt, label, start = 50 } = Astro.props;
---

<figure data-reveal>
  <div class="compare relative aspect-video overflow-hidden rounded-xl bg-white shadow-lg ring-1 ring-gls-ink/10" style={`--pos: ${start}%`}>
    <Image src={before} alt={beforeAlt} width={960} class="absolute inset-0 h-full w-full object-cover" />
    <Image src={after} alt={afterAlt} width={960} class="compare-after absolute inset-0 h-full w-full object-cover" />

    <span class="pointer-events-none absolute top-3 left-3 rounded-full bg-gls-ink/75 px-2.5 py-1 text-xs font-semibold text-white">
      Storyboard
    </span>
    <span class="compare-tag-after pointer-events-none absolute top-3 right-3 rounded-full bg-gls-yellow px-2.5 py-1 text-xs font-semibold text-gls-green-dark">
      Finished
    </span>

    <span class="compare-line pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-white shadow" aria-hidden="true">
      <span class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white text-gls-green-dark shadow-lg">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path>
        </svg>
      </span>
    </span>

    <input
      type="range"
      min="0"
      max="100"
      value={start}
      aria-label={`${label}: drag to compare the storyboard with the finished frame`}
      class="compare-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
    />
  </div>
  <figcaption class="mt-3 font-heading font-bold">{label}</figcaption>
</figure>

<style>
  .compare-after {
    clip-path: inset(0 0 0 var(--pos));
  }
  .compare-line {
    left: var(--pos);
  }
  .compare-range:focus-visible ~ .compare-line > span {
    outline: 3px solid var(--color-gls-yellow);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.compare').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('.compare-range')!;
    const set = () => box.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', set);
    set();
  });
</script>
