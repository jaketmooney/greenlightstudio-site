---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { NAV, SOCIAL } from '../data/site';

interface Props {
  /** Overlay the header on the page's own hero instead of sitting in a bar.
      Only the homepage has a hero to overlay. */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
---

<header
  class:list={[
    'w-full',
    transparent ? 'absolute inset-x-0 top-0 z-20 bg-transparent' : 'bg-gls-green-dark',
  ]}
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4">
    <a href="/" aria-label="Green Light Studio home" class="shrink-0">
      <Image src={logo} alt="Green Light Studio" width={200} loading="eager" />
    </a>

    <nav
      class:list={[
        'order-3 flex-wrap items-center gap-6 sm:order-2 sm:flex',
        transparent ? 'hidden sm:flex' : 'flex',
      ]}
      aria-label="Main"
    >
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="font-heading text-sm font-semibold text-white transition hover:text-gls-yellow sm:text-base"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <nav
      class:list={[
        'order-2 ml-auto items-center gap-4 sm:order-3 sm:flex',
        transparent ? 'hidden sm:flex' : 'flex',
      ]}
      aria-label="Social links"
    >
      {
        SOCIAL.map((s) => (
          <a href={s.href} aria-label={s.label} class="text-white transition hover:text-gls-yellow">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
              focusable="false"
            >
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
</header>
