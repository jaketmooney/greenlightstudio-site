---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import logoDark from '../assets/logo-dark.png';
import { NAV, SOCIAL } from '../data/site';

interface Props {
  /** Overlay the header on the page's own hero instead of sitting in a bar.
      Only the homepage has a hero to overlay. */
  transparent?: boolean;
  /** With `transparent`: the hero behind is light, so use dark text and the
      dark-lettered logo. */
  onLight?: boolean;
}
const { transparent = false, onLight = false } = Astro.props;
// Over a hero the header steps back a little (smaller logo, lighter weight)
// so it doesn't compete with the headline.
const text = onLight ? 'text-gls-ink/80 hover:text-gls-green-dark' : 'text-white hover:text-gls-yellow';
---

<header
  class:list={[
    'w-full',
    transparent ? 'absolute inset-x-0 top-0 z-20 bg-transparent' : 'bg-gls-green-dark',
  ]}
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-4">
    <a href="/" aria-label="Green Light Studio home" class="shrink-0">
      <Image src={onLight ? logoDark : logo} alt="Green Light Studio" width={transparent ? 170 : 200} loading="eager" />
    </a>

    <nav
      class:list={[
        'order-3 flex-wrap items-center gap-6 sm:order-2 sm:flex',
        transparent ? 'hidden sm:flex' : 'flex',
      ]}
      aria-label="Main"
    >
      {
        NAV.map((item) =>
          item.children ? (
            <details class="group relative" data-nav-drop>
              <summary
                class:list={[
                  'flex cursor-pointer list-none items-center gap-1 font-heading text-sm transition sm:text-base [&::-webkit-details-marker]:hidden',
                  transparent ? 'font-medium' : 'font-semibold',
                  text,
                ]}
              >
                {item.label}
                <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform group-open:rotate-180" aria-hidden="true">
                  <path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              {/* Padding rather than margin above the card, so the pointer can cross the gap without leaving the dropdown. */}
              <div class="absolute top-full right-0 z-30 pt-3 sm:right-auto sm:left-1/2 sm:-translate-x-1/2">
                <ul class="w-max rounded-xl bg-white p-2 shadow-xl ring-1 ring-black/5">
                  {item.children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        class="block rounded-lg px-4 py-2.5 font-heading text-sm font-medium text-gls-ink transition hover:bg-gls-paper hover:text-gls-green-dark sm:text-base"
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ) : (
            <a
              href={item.href}
              class:list={['font-heading text-sm transition sm:text-base', transparent ? 'font-medium' : 'font-semibold', text]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <nav
      class:list={[
        'order-2 ml-auto items-center gap-4 sm:order-3 sm:flex',
        transparent ? 'hidden sm:flex' : 'flex',
      ]}
      aria-label="Social links"
    >
      {
        SOCIAL.map((s) => (
          <a href={s.href} aria-label={s.label} class:list={['transition', text]}>
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-5 w-5"
              aria-hidden="true"
              focusable="false"
            >
              <path d={s.path} />
            </svg>
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  // Dropdowns open on click or tap (it's a <details>), and also on hover where
  // there's a mouse. A click elsewhere or Escape closes them.
  const drops = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-drop]')];
  const hover = matchMedia('(hover: hover) and (pointer: fine)');
  for (const d of drops) {
    d.addEventListener('mouseenter', () => { if (hover.matches) d.open = true; });
    d.addEventListener('mouseleave', () => { if (hover.matches) d.open = false; });
  }
  document.addEventListener('click', (e) => {
    for (const d of drops) if (d.open && !d.contains(e.target as Node)) d.open = false;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const d of drops) if (d.open) { d.open = false; d.querySelector('summary')?.focus(); }
  });
</script>
