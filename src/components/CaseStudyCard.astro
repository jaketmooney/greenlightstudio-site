---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'caseStudies'>;
  class?: string;
}
const { entry, class: className } = Astro.props;
---
<a
  data-reveal
  href={`/case-studies/${entry.id}/`}
  class:list={['group block overflow-hidden rounded-lg bg-white shadow transition hover:shadow-xl motion-safe:hover:-translate-y-1', className]}
>
  <Image src={entry.data.heroImage} alt={entry.data.heroAlt} width={600} height={400}
         class="h-48 w-full object-cover transition duration-700 group-hover:scale-105" />
  <div class="p-5">
    <p class="text-sm font-semibold text-gls-green">{entry.data.client}</p>
    <h3 class="mt-1 text-lg">{entry.data.title}</h3>
  </div>
</a>
